# ── Backend (backend/.env) ──────────────────────────────────────────────

# Claude API key — enables the AI analyst (chat, thesis drafting, memos).
# Everything else works without it.
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact info (403 without it).
EDGAR_USER_AGENT=InvestmentCopilot/0.1 (you@example.com)

# Database. Leave empty locally (SQLite at backend/data/copilot.db).
# In production set the Neon/Postgres URL (postgres:// or postgresql://).
DATABASE_URL=

# Shared secret between the Next.js proxy and the backend. When set, every
# API request must carry "Authorization: Bearer <token>". Generate with:
#   openssl rand -hex 32
# Leave empty for local dev. Must match API_AUTH_TOKEN in the frontend env.
API_AUTH_TOKEN=

# ── Frontend (frontend/.env.local) ───────────────────────────────────────

# Skip Google sign-in entirely for local dev (do NOT set in production).
AUTH_DISABLED=true

# Auth.js session-cookie signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials (console.cloud.google.com → APIs → Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails allowed to sign in. Everyone else is rejected.
ALLOWED_EMAILS=you@gmail.com

# Where the FastAPI backend lives. Local default: http://localhost:8000
# In production: your backend Vercel deployment URL.
BACKEND_URL=

# Must match the backend's API_AUTH_TOKEN (set in production only).
# API_AUTH_TOKEN=
